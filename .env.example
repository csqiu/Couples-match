# Copy to .env.local (never commit real values).

# --- Web app (Phase 5+) -------------------------------------------------------
# From the Supabase project (Settings → API), or `supabase status` locally.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the app, used in invite links and auth redirects.
APP_URL=http://localhost:3000

# --- Supabase Auth: Google sign-in (optional) --------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Edge Function secrets (set with `supabase secrets set`, not here in prod) -
RESEND_API_KEY=
INVITE_FROM_EMAIL="Pairwise <invites@example.com>"

# --- Tests ---------------------------------------------------------------------
# Optional. A superuser Postgres URL (e.g. `supabase start`'s db). Without it the
# database tests start a throwaway local Postgres (PostgreSQL 16 + PostGIS needed).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
